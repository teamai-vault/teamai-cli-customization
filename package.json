  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
