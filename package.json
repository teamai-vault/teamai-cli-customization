{
  "name": "teamai-cli-customization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "team-ai": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
